generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServerSetting {
  id                           String   @id @default(uuid())
  instanceId                   String   @unique @default(uuid())
  serverName                   String   @default("OhMyDungeon")
  registrationEnabled          Boolean  @default(true)
  defaultLocale                String   @default("zh-CN")
  allowPublicCampaignDiscovery Boolean  @default(false)
  maxUploadSizeMb              Int      @default(20)
  enabledSystems               Json     @default("[\"dnd5e\"]")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model User {
  id                  String                     @id @default(uuid())
  username            String                     @unique
  email               String                     @unique
  passwordHash        String
  displayName         String?
  avatarUrl           String?
  avatarAssetId       String?
  defaultClientMode   String                     @default("player")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  serverAdmin         ServerAdmin?
  refreshTokens       RefreshToken[]
  ownedCampaigns      Campaign[]
  campaignMemberships CampaignMember[]
  characters          Character[]
  characterBindings   CharacterCampaignBinding[]
  checkRequests       CheckRequest[]
  checkResponses      CheckResponse[]
  vaultEntities       VaultEntity[]
  vaultDevices        VaultDevice[]
  conversationReads   CampaignConversationRead[]
}

model VaultEntity {
  id         String   @id @default(uuid())
  userId     String
  entityType String
  entityId   String
  payload    Json
  revision   Int      @default(1)
  deletedAt  DateTime?
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId, updatedAt])
}

model VaultChange {
  cursor     BigInt   @id @default(autoincrement())
  userId     String
  entityType String
  entityId   String
  operation  String
  payload    Json
  revision   Int
  createdAt  DateTime @default(now())

  @@index([userId, cursor])
}

model VaultOperation {
  operationId String
  userId      String
  createdAt   DateTime @default(now())

  @@id([userId, operationId])
  @@index([userId])
}

model VaultDevice {
  id         String    @id @default(uuid())
  userId     String
  deviceId   String
  name       String
  platform   String
  lastCursor BigInt    @default(0)
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, lastSeenAt])
}

model ServerAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique
  role      String   @default("admin")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id                String                     @id @default(uuid())
  name              String
  description       String                     @default("")
  system            String                     @default("dnd5e")
  ownerId           String
  status            String                     @default("active")
  avatarAssetId     String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  owner             User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members           CampaignMember[]
  invites           CampaignInvite[]
  chatMessages      CampaignChatMessage[]
  sessions          Session[]
  characterBindings CharacterCampaignBinding[]
  journal           JournalEntry[]
  npcs              Npc[]
  encounters        Encounter[]
  syncState         CampaignSyncState?
  characters            CampaignCharacter[]
  contentEntries    CampaignContentEntry[]
  changes           CampaignChange[]
  archiveEntries    CampaignArchiveEntry[]
  conversations     CampaignConversation[]
  characterStates   CharacterState[]
  gameEvents        GameEvent[]
}

model CampaignArchiveEntry {
  id         String   @id @default(uuid())
  campaignId String
  kind       String
  title      String
  summary    String   @default("")
  payload    Json     @default("{}")
  visibility String   @default("members")
  pinned     Boolean  @default(false)
  createdBy  String
  updatedBy  String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, kind, deletedAt])
  @@index([campaignId, pinned, updatedAt])
}

model MediaAsset {
  id          String   @id
  ownerUserId String
  campaignId  String?
  purpose     String
  mimeType    String
  byteSize    Int
  storageKey  String   @unique
  sha256      String
  createdAt   DateTime @default(now())

  @@index([ownerUserId, createdAt])
  @@index([campaignId, createdAt])
}

model CampaignSyncState {
  campaignId String   @id
  cursor     BigInt   @default(0)
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignCharacter {
  id                String              @id @default(uuid())
  campaignId        String
  ownerUserId       String?
  sourceCharacterId String?
  characterType     String              @default("player") @map("actorType")
  status            String              @default("active")
  lifecycle         String              @default("persistent")
  visibleToPlayers  Boolean             @default(false)
  avatarAssetId     String?
  healthVisibility  String              @default("ownerAndDm")
  sheetJson         Json
  revision          Int                 @default(1)
  updatedBy         String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  campaign          Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  audits            CampaignCharacterAudit[]
  chatMessages      CampaignChatMessage[]

  @@unique([campaignId, sourceCharacterId])
  @@index([campaignId, status])
  @@index([ownerUserId])
  @@map("CampaignActor")
}

model CampaignCharacterAudit {
  id              String        @id @default(uuid())
  campaignCharacterId String @map("campaignActorId")
  campaignId      String
  characterUserId     String @map("actorUserId")
  baseRevision    Int
  resultRevision  Int
  changedPaths    Json
  beforeJson      Json
  afterJson       Json
  createdAt       DateTime      @default(now())
  campaignCharacter   CampaignCharacter @relation(fields: [campaignCharacterId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@map("CampaignActorAudit")
}

model CampaignContentEntry {
  id         String    @id @default(uuid())
  campaignId String
  type       String
  slug       String
  name       String
  entryJson  Json
  revision   Int       @default(1)
  createdBy  String
  updatedBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, slug])
  @@index([campaignId, type, deletedAt])
}

model CampaignChange {
  id         String   @id @default(uuid())
  campaignId String
  cursor     BigInt
  entityType String
  entityId   String
  operation  String
  revision   Int
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, cursor])
  @@index([campaignId, cursor])
}

model CampaignChatMessage {
  id               String              @id @default(uuid())
  campaignId       String
  conversationId   String?
  senderId         String
  campaignCharacterId  String? @map("campaignActorId")
  displayName      String              @default("")
  avatarUrl        String?
  speakerMode      String              @default("character")
  delegatedByUserId String?
  speakerAvatarAssetId String?
  publicHealthState String?
  publicHealthFraction Float?
  ooc              Boolean             @default(false)
  kind             String              @default("say")
  content          String
  actionSnapshot   Json?
  eventData        Json?
  createdAt        DateTime            @default(now())
  campaign         Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  campaignCharacter    CampaignCharacter?      @relation(fields: [campaignCharacterId], references: [id], onDelete: SetNull)
  conversation     CampaignConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([campaignId, createdAt])
  @@index([senderId])
  @@index([campaignCharacterId])
  @@index([conversationId, createdAt])
}

model CampaignConversation {
  id             String   @id @default(uuid())
  campaignId     String
  kind           String   @default("main")
  title          String   @default("")
  mainKey        String?
  directKey      String?
  participantIds String[]
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  archivedAt     DateTime?
  campaign       Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  messages       CampaignChatMessage[]
  reads          CampaignConversationRead[]

  @@unique([campaignId, mainKey])
  @@unique([campaignId, directKey])
  @@index([campaignId, kind])
}

model CampaignConversationRead {
  id             String               @id @default(uuid())
  conversationId String
  userId         String
  lastReadAt     DateTime
  conversation   CampaignConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, lastReadAt])
}

model CampaignMember {
  id          String   @id @default(uuid())
  campaignId  String
  userId      String
  role        String   @default("player")
  displayName String   @default("")
  boundCharacterId String? @map("boundActorId")
  activeSpeakerCharacterId String? @map("activeSpeakerActorId")
  speakerMode String   @default("boundCharacter")
  lastReadAt DateTime?
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

model CampaignInvite {
  id              String    @id @default(uuid())
  campaignId      String
  code            String    @unique
  roleOnJoin      String    @default("player")
  expiresAt       DateTime?
  maxUses         Int       @default(1)
  usedCount       Int       @default(0)
  requireApproval Boolean   @default(false)
  createdBy       String
  createdAt       DateTime  @default(now())
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Session {
  id         String          @id @default(uuid())
  campaignId String
  name       String
  status     String          @default("scheduled")
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  members    SessionMember[]
  messages   ChatMessage[]
  rolls      DiceRoll[]
  journal    JournalEntry[]
  encounters Encounter[]
  checks     CheckRequest[]
}

model SessionMember {
  id        String    @id @default(uuid())
  sessionId String
  userId    String
  role      String    @default("player")
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model ChatMessage {
  id         String   @id @default(uuid())
  sessionId  String
  senderId   String
  kind       String   @default("text")
  visibility String   @default("public")
  content    String
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model DiceRoll {
  id         String   @id @default(uuid())
  sessionId  String
  characterId    String @map("actorId")
  characterName  String @map("actorName")
  notation   String
  total      Int
  components Json
  visibility String   @default("public")
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id         String    @id @default(uuid())
  campaignId String?
  sessionId  String?
  type       String
  summary    String
  refId      String?
  createdAt  DateTime  @default(now())
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  session    Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Character {
  id                    String                     @id @default(uuid())
  ownerUserId           String
  name                  String
  avatarUrl             String?
  system                String                     @default("dnd5e")
  level                 Int                        @default(1)
  classSummary          String                     @default("")
  raceSummary           String                     @default("")
  currentHp             Int                        @default(0)
  maxHp                 Int                        @default(0)
  armorClass            Int                        @default(10)
  speed                 Int                        @default(30)
  initiativeBonus       Int                        @default(0)
  abilities             Json                       @default("{\"str\":10,\"dex\":10,\"con\":10,\"int\":10,\"wis\":10,\"cha\":10}")
  saves                 Json                       @default("{}")
  skills                Json                       @default("{}")
  inventory             Json                       @default("[]")
  currency              Json                       @default("{}")
  notes                 String                     @default("")
  data                  Json                       @default("{}")
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  owner                 User                       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  campaignBindings      CharacterCampaignBinding[]
  encounterParticipants EncounterParticipant[]
  checkResponses        CheckResponse[]
  states                CharacterState[]
  gameEvents            GameEvent[]
}

model CharacterState {
  id          String    @id @default(uuid())
  characterId String
  campaignId  String?
  scopeKey    String
  stateJson   Json
  revision    Int       @default(1)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([characterId, scopeKey])
  @@index([campaignId])
}

model GameEvent {
  id            String    @id @default(uuid())
  schemaVersion Int       @default(1)
  type          String
  campaignId    String?
  characterId   String?
  initiatorType String @map("actorType")
  initiatorId   String @map("actorId")
  requestId     String    @unique
  targets       Json      @default("[]")
  cause         Json?
  before        Json      @default("{}")
  after         Json      @default("{}")
  payload       Json      @default("{}")
  occurredAt    DateTime  @default(now())
  campaign      Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character     Character? @relation(fields: [characterId], references: [id], onDelete: Cascade)

  @@index([campaignId, occurredAt])
  @@index([characterId, occurredAt])
  @@index([type, occurredAt])
}

model CheckRequest {
  id                 String          @id @default(uuid())
  sessionId          String
  requestedBy        String
  label              String
  checkType          String          @default("skill")
  ability            String?
  skill              String?
  dc                 Int?
  dcVisibility       String          @default("public")
  targetMode         String          @default("all")
  targetUserIds      Json            @default("[]")
  targetCharacterIds Json            @default("[]")
  status             String          @default("open")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  session            Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requester          User            @relation(fields: [requestedBy], references: [id], onDelete: Cascade)
  responses          CheckResponse[]

  @@index([sessionId])
  @@index([requestedBy])
}

model CheckResponse {
  id          String       @id @default(uuid())
  requestId   String
  responderId String
  characterId String?
  notation    String
  total       Int
  components  Json
  result      String       @default("unknown")
  createdAt   DateTime     @default(now())
  request     CheckRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  responder   User         @relation(fields: [responderId], references: [id], onDelete: Cascade)
  character   Character?   @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([requestId, responderId])
  @@index([requestId])
  @@index([responderId])
  @@index([characterId])
}

model Npc {
  id                    String                 @id @default(uuid())
  campaignId            String
  contentItemId         String?
  name                  String
  publicDescription     String                 @default("")
  dmNotes               String                 @default("")
  stats                 Json                   @default("{}")
  tags                  Json                   @default("[]")
  createdBy             String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  campaign              Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  encounterParticipants EncounterParticipant[]

  @@index([campaignId])
}

model Encounter {
  id                       String                 @id @default(uuid())
  campaignId               String
  sessionId                String?
  name                     String
  status                   String                 @default("draft")
  round                    Int                    @default(0)
  currentTurnParticipantId String?
  createdBy                String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  campaign                 Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  session                  Session?               @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  participants             EncounterParticipant[]

  @@index([campaignId])
  @@index([sessionId])
}

model EncounterParticipant {
  id                  String     @id @default(uuid())
  encounterId         String
  participantType     String
  characterId         String?
  npcId               String?
  displayName         String
  initiative          Int        @default(0)
  hpCurrent           Int        @default(0)
  hpMax               Int        @default(0)
  armorClass          Int        @default(10)
  conditions          Json       @default("[]")
  isHiddenFromPlayers Boolean    @default(false)
  sortOrder           Int        @default(0)
  snapshot            Json       @default("{}")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  encounter           Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  character           Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  npc                 Npc?       @relation(fields: [npcId], references: [id], onDelete: SetNull)

  @@index([encounterId])
  @@index([characterId])
  @@index([npcId])
}

model CharacterCampaignBinding {
  id          String    @id @default(uuid())
  campaignId  String
  characterId String
  userId      String
  visibility  String    @default("party")
  status      String    @default("active")
  dmNotes     String    @default("")
  joinedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, characterId])
}
