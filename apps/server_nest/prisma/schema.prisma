generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServerSetting {
  id                           String   @id @default(uuid())
  serverName                   String   @default("D&D Table Tool")
  registrationEnabled          Boolean  @default(true)
  defaultLocale                String   @default("zh-CN")
  allowPublicCampaignDiscovery Boolean  @default(false)
  maxUploadSizeMb              Int      @default(20)
  enabledSystems               Json     @default("[\"dnd5e\"]")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model User {
  id                  String                     @id @default(uuid())
  username            String                     @unique
  email               String                     @unique
  passwordHash        String
  displayName         String?
  avatarUrl           String?
  defaultClientMode   String                     @default("player")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  serverAdmin         ServerAdmin?
  refreshTokens       RefreshToken[]
  ownedCampaigns      Campaign[]
  campaignMemberships CampaignMember[]
  characters          Character[]
  characterBindings   CharacterCampaignBinding[]
}

model ServerAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique
  role      String   @default("admin")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id                String                     @id @default(uuid())
  name              String
  description       String                     @default("")
  system            String                     @default("dnd5e")
  ownerId           String
  status            String                     @default("active")
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  owner             User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members           CampaignMember[]
  invites           CampaignInvite[]
  sessions          Session[]
  characterBindings CharacterCampaignBinding[]
  journal           JournalEntry[]
}

model CampaignMember {
  id          String   @id @default(uuid())
  campaignId  String
  userId      String
  role        String   @default("player")
  displayName String   @default("")
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

model CampaignInvite {
  id              String    @id @default(uuid())
  campaignId      String
  code            String    @unique
  roleOnJoin      String    @default("player")
  expiresAt       DateTime?
  maxUses         Int       @default(1)
  usedCount       Int       @default(0)
  requireApproval Boolean   @default(false)
  createdBy       String
  createdAt       DateTime  @default(now())
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Session {
  id         String          @id @default(uuid())
  campaignId String
  name       String
  status     String          @default("scheduled")
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  members    SessionMember[]
  messages   ChatMessage[]
  rolls      DiceRoll[]
  journal    JournalEntry[]
}

model SessionMember {
  id        String    @id @default(uuid())
  sessionId String
  userId    String
  role      String    @default("player")
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model ChatMessage {
  id         String   @id @default(uuid())
  sessionId  String
  senderId   String
  kind       String   @default("text")
  visibility String   @default("public")
  content    String
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model DiceRoll {
  id         String   @id @default(uuid())
  sessionId  String
  actorId    String
  actorName  String
  notation   String
  total      Int
  components Json
  visibility String   @default("public")
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id         String    @id @default(uuid())
  campaignId String?
  sessionId  String?
  type       String
  summary    String
  refId      String?
  createdAt  DateTime  @default(now())
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  session    Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model Character {
  id               String                     @id @default(uuid())
  ownerUserId      String
  name             String
  avatarUrl        String?
  system           String                     @default("dnd5e")
  level            Int                        @default(1)
  classSummary     String                     @default("")
  raceSummary      String                     @default("")
  currentHp        Int                        @default(0)
  maxHp            Int                        @default(0)
  armorClass       Int                        @default(10)
  speed            Int                        @default(30)
  initiativeBonus  Int                        @default(0)
  abilities        Json                       @default("{\"str\":10,\"dex\":10,\"con\":10,\"int\":10,\"wis\":10,\"cha\":10}")
  saves            Json                       @default("{}")
  skills           Json                       @default("{}")
  inventory        Json                       @default("[]")
  currency         Json                       @default("{}")
  notes            String                     @default("")
  data             Json                       @default("{}")
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  owner            User                       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  campaignBindings CharacterCampaignBinding[]
}

model CharacterCampaignBinding {
  id          String    @id @default(uuid())
  campaignId  String
  characterId String
  userId      String
  visibility  String    @default("party")
  status      String    @default("active")
  dmNotes     String    @default("")
  joinedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, characterId])
}
