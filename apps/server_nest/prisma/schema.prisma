generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model ServerSetting {
  id                           String   @id @default(uuid())
  serverName                   String   @default("D&D Table Tool")
  registrationEnabled          Boolean  @default(true)
  defaultLocale                String   @default("zh-CN")
  allowPublicCampaignDiscovery Boolean  @default(false)
  maxUploadSizeMb              Int      @default(20)
  enabledSystems               Json     @default("[\"dnd5e\"]")
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
}

model User {
  id                  String                     @id @default(uuid())
  username            String                     @unique
  email               String                     @unique
  passwordHash        String
  displayName         String?
  avatarUrl           String?
  defaultClientMode   String                     @default("player")
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  serverAdmin         ServerAdmin?
  refreshTokens       RefreshToken[]
  ownedCampaigns      Campaign[]
  campaignMemberships CampaignMember[]
  characters          Character[]
  characterBindings   CharacterCampaignBinding[]
  contentPackages     ContentPackage[]
  contentFavorites    UserContentFavorite[]
  checkRequests       CheckRequest[]
  checkResponses      CheckResponse[]
  vaultEntities       VaultEntity[]
  vaultDevices        VaultDevice[]
}

model VaultEntity {
  id         String   @id @default(uuid())
  userId     String
  entityType String
  entityId   String
  payload    Json
  revision   Int      @default(1)
  deletedAt  DateTime?
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, entityType, entityId])
  @@index([userId, updatedAt])
}

model VaultChange {
  cursor     BigInt   @id @default(autoincrement())
  userId     String
  entityType String
  entityId   String
  operation  String
  payload    Json
  revision   Int
  createdAt  DateTime @default(now())

  @@index([userId, cursor])
}

model VaultOperation {
  operationId String   @id
  userId      String
  createdAt   DateTime @default(now())

  @@index([userId])
}

model VaultDevice {
  id         String    @id @default(uuid())
  userId     String
  deviceId   String
  name       String
  platform   String
  lastCursor BigInt    @default(0)
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId, lastSeenAt])
}

model ServerAdmin {
  id        String   @id @default(uuid())
  userId    String   @unique
  role      String   @default("admin")
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Campaign {
  id                String                     @id @default(uuid())
  name              String
  description       String                     @default("")
  system            String                     @default("dnd5e")
  ownerId           String
  status            String                     @default("active")
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  owner             User                       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members           CampaignMember[]
  invites           CampaignInvite[]
  chatMessages      CampaignChatMessage[]
  sessions          Session[]
  characterBindings CharacterCampaignBinding[]
  journal           JournalEntry[]
  contentPackages   CampaignContentPackage[]
  scopedContent     ContentPackage[]
  contentOverrides  ContentOverride[]
  npcs              Npc[]
  encounters        Encounter[]
  syncState         CampaignSyncState?
  actors            CampaignActor[]
  contentEntries    CampaignContentEntry[]
  changes           CampaignChange[]
}

model CampaignSyncState {
  campaignId String   @id
  cursor     BigInt   @default(0)
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model CampaignActor {
  id                String              @id @default(uuid())
  campaignId        String
  ownerUserId       String?
  sourceCharacterId String?
  actorType         String              @default("player")
  status            String              @default("active")
  sheetJson         Json
  revision          Int                 @default(1)
  updatedBy         String
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  campaign          Campaign            @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  audits            CampaignActorAudit[]

  @@unique([campaignId, sourceCharacterId])
  @@index([campaignId, status])
  @@index([ownerUserId])
}

model CampaignActorAudit {
  id              String        @id @default(uuid())
  campaignActorId String
  campaignId      String
  actorUserId     String
  baseRevision    Int
  resultRevision  Int
  changedPaths    Json
  beforeJson      Json
  afterJson       Json
  createdAt       DateTime      @default(now())
  campaignActor   CampaignActor @relation(fields: [campaignActorId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
}

model CampaignContentEntry {
  id         String    @id @default(uuid())
  campaignId String
  type       String
  slug       String
  name       String
  entryJson  Json
  revision   Int       @default(1)
  createdBy  String
  updatedBy  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  campaign   Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, slug])
  @@index([campaignId, type, deletedAt])
}

model CampaignChange {
  id         String   @id @default(uuid())
  campaignId String
  cursor     BigInt
  entityType String
  entityId   String
  operation  String
  revision   Int
  createdAt  DateTime @default(now())
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, cursor])
  @@index([campaignId, cursor])
}

model CampaignChatMessage {
  id          String   @id @default(uuid())
  campaignId  String
  senderId    String
  characterId String?
  displayName String   @default("")
  avatarUrl   String?
  kind        String   @default("say")
  content     String
  createdAt   DateTime @default(now())
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, createdAt])
  @@index([senderId])
  @@index([characterId])
}

model CampaignMember {
  id          String   @id @default(uuid())
  campaignId  String
  userId      String
  role        String   @default("player")
  displayName String   @default("")
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
}

model CampaignInvite {
  id              String    @id @default(uuid())
  campaignId      String
  code            String    @unique
  roleOnJoin      String    @default("player")
  expiresAt       DateTime?
  maxUses         Int       @default(1)
  usedCount       Int       @default(0)
  requireApproval Boolean   @default(false)
  createdBy       String
  createdAt       DateTime  @default(now())
  campaign        Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Session {
  id         String          @id @default(uuid())
  campaignId String
  name       String
  status     String          @default("scheduled")
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  members    SessionMember[]
  messages   ChatMessage[]
  rolls      DiceRoll[]
  journal    JournalEntry[]
  encounters Encounter[]
  checks     CheckRequest[]
}

model SessionMember {
  id        String    @id @default(uuid())
  sessionId String
  userId    String
  role      String    @default("player")
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?
  session   Session   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model ChatMessage {
  id         String   @id @default(uuid())
  sessionId  String
  senderId   String
  kind       String   @default("text")
  visibility String   @default("public")
  content    String
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model DiceRoll {
  id         String   @id @default(uuid())
  sessionId  String
  actorId    String
  actorName  String
  notation   String
  total      Int
  components Json
  visibility String   @default("public")
  createdAt  DateTime @default(now())
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model JournalEntry {
  id         String    @id @default(uuid())
  campaignId String?
  sessionId  String?
  type       String
  summary    String
  refId      String?
  createdAt  DateTime  @default(now())
  campaign   Campaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  session    Session?  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

model ContentPackage {
  id              String                   @id @default(uuid())
  scope           String                   @default("user")
  ownerUserId     String?
  campaignId      String?
  name            String
  version         String
  schemaVersion   Int                      @default(1)
  locale          String                   @default("zh-CN")
  status          String                   @default("active")
  createdBy       String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  owner           User?                    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  campaign        Campaign?                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  items           ContentItem[]
  campaignEnables CampaignContentPackage[]

  @@index([ownerUserId])
  @@index([campaignId])
}

model ContentItem {
  id               String            @id @default(uuid())
  packageId        String
  type             String
  slug             String
  name             String
  description      String            @default("")
  structured       Json              @default("{}")
  tags             Json              @default("[]")
  sourceLabel      String            @default("")
  schemaVersion    Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  package          ContentPackage    @relation(fields: [packageId], references: [id], onDelete: Cascade)
  baseOverrides    ContentOverride[] @relation("BaseContentItem")
  derivedOverrides ContentOverride[] @relation("DerivedContentItem")
  outgoingLinks     ContentItemLink[] @relation("ContentItemLinkSource")
  incomingLinks     ContentItemLink[] @relation("ContentItemLinkTarget")
  favorites         UserContentFavorite[]

  @@unique([packageId, type, slug])
  @@index([type])
}

model ContentItemLink {
  id           String      @id @default(uuid())
  sourceItemId String
  targetItemId String
  relation     String
  label        String      @default("")
  sortOrder    Int         @default(0)
  source       ContentItem @relation("ContentItemLinkSource", fields: [sourceItemId], references: [id], onDelete: Cascade)
  target       ContentItem @relation("ContentItemLinkTarget", fields: [targetItemId], references: [id], onDelete: Cascade)

  @@unique([sourceItemId, targetItemId, relation])
  @@index([targetItemId])
}

model UserContentFavorite {
  id            String      @id @default(uuid())
  userId        String
  contentItemId String
  createdAt     DateTime    @default(now())
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  @@unique([userId, contentItemId])
  @@index([contentItemId])
}

model CampaignContentPackage {
  id         String         @id @default(uuid())
  campaignId String
  packageId  String
  enabled    Boolean        @default(true)
  enabledBy  String
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  campaign   Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  package    ContentPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([campaignId, packageId])
}

model ContentOverride {
  id                   String       @id @default(uuid())
  campaignId           String
  baseContentItemId    String
  overrideType         String
  derivedContentItemId String?
  patchData            Json         @default("{}")
  reason               String       @default("")
  createdBy            String
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  campaign             Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  baseContentItem      ContentItem  @relation("BaseContentItem", fields: [baseContentItemId], references: [id], onDelete: Cascade)
  derivedContentItem   ContentItem? @relation("DerivedContentItem", fields: [derivedContentItemId], references: [id], onDelete: SetNull)

  @@index([campaignId])
  @@index([baseContentItemId])
}

model Character {
  id                    String                     @id @default(uuid())
  ownerUserId           String
  name                  String
  avatarUrl             String?
  system                String                     @default("dnd5e")
  level                 Int                        @default(1)
  classSummary          String                     @default("")
  raceSummary           String                     @default("")
  currentHp             Int                        @default(0)
  maxHp                 Int                        @default(0)
  armorClass            Int                        @default(10)
  speed                 Int                        @default(30)
  initiativeBonus       Int                        @default(0)
  abilities             Json                       @default("{\"str\":10,\"dex\":10,\"con\":10,\"int\":10,\"wis\":10,\"cha\":10}")
  saves                 Json                       @default("{}")
  skills                Json                       @default("{}")
  inventory             Json                       @default("[]")
  currency              Json                       @default("{}")
  notes                 String                     @default("")
  data                  Json                       @default("{}")
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  owner                 User                       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  campaignBindings      CharacterCampaignBinding[]
  encounterParticipants EncounterParticipant[]
  checkResponses        CheckResponse[]
}

model CheckRequest {
  id                 String          @id @default(uuid())
  sessionId          String
  requestedBy        String
  label              String
  checkType          String          @default("skill")
  ability            String?
  skill              String?
  dc                 Int?
  dcVisibility       String          @default("public")
  targetMode         String          @default("all")
  targetUserIds      Json            @default("[]")
  targetCharacterIds Json            @default("[]")
  status             String          @default("open")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  session            Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  requester          User            @relation(fields: [requestedBy], references: [id], onDelete: Cascade)
  responses          CheckResponse[]

  @@index([sessionId])
  @@index([requestedBy])
}

model CheckResponse {
  id          String       @id @default(uuid())
  requestId   String
  responderId String
  characterId String?
  notation    String
  total       Int
  components  Json
  result      String       @default("unknown")
  createdAt   DateTime     @default(now())
  request     CheckRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  responder   User         @relation(fields: [responderId], references: [id], onDelete: Cascade)
  character   Character?   @relation(fields: [characterId], references: [id], onDelete: SetNull)

  @@unique([requestId, responderId])
  @@index([requestId])
  @@index([responderId])
  @@index([characterId])
}

model Npc {
  id                    String                 @id @default(uuid())
  campaignId            String
  contentItemId         String?
  name                  String
  publicDescription     String                 @default("")
  dmNotes               String                 @default("")
  stats                 Json                   @default("{}")
  tags                  Json                   @default("[]")
  createdBy             String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  campaign              Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  encounterParticipants EncounterParticipant[]

  @@index([campaignId])
}

model Encounter {
  id                       String                 @id @default(uuid())
  campaignId               String
  sessionId                String?
  name                     String
  status                   String                 @default("draft")
  round                    Int                    @default(0)
  currentTurnParticipantId String?
  createdBy                String
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  campaign                 Campaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  session                  Session?               @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  participants             EncounterParticipant[]

  @@index([campaignId])
  @@index([sessionId])
}

model EncounterParticipant {
  id                  String     @id @default(uuid())
  encounterId         String
  participantType     String
  characterId         String?
  npcId               String?
  displayName         String
  initiative          Int        @default(0)
  hpCurrent           Int        @default(0)
  hpMax               Int        @default(0)
  armorClass          Int        @default(10)
  conditions          Json       @default("[]")
  isHiddenFromPlayers Boolean    @default(false)
  sortOrder           Int        @default(0)
  snapshot            Json       @default("{}")
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  encounter           Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  character           Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  npc                 Npc?       @relation(fields: [npcId], references: [id], onDelete: SetNull)

  @@index([encounterId])
  @@index([characterId])
  @@index([npcId])
}

model CharacterCampaignBinding {
  id          String    @id @default(uuid())
  campaignId  String
  characterId String
  userId      String
  visibility  String    @default("party")
  status      String    @default("active")
  dmNotes     String    @default("")
  joinedAt    DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  campaign    Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  character   Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, characterId])
}
