# D&D Table Server 配置
# 首次运行 start.sh 时会自动复制此文件为 .env 并生成随机密钥/密码。
# 以下仅用于本地开发直接运行（非 Docker）；Docker 部署时 DATABASE_URL 和
# POSTGRES_PASSWORD 由 docker-compose.yml 从 .env 注入，无需手动修改。

SERVER_NAME="D&D Table Tool"
PUBLIC_BASE_URL="http://localhost:3000"

# 数据库（Docker 部署时主机名为 postgres；本机直连开发用 localhost）
POSTGRES_PASSWORD="change-me"
DATABASE_URL="postgresql://dnd:change-me@localhost:5432/dnd_table"

# 鉴权密钥（start.sh 首次启动会自动生成随机值覆盖）
JWT_SECRET="change-me"

# 注册与本地化
REGISTRATION_ENABLED=true
DEFAULT_LOCALE="zh-CN"

# 上传目录与大小上限（MB）
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=20
